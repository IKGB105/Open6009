{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: archivo actual (DAQ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": { "PYTHONPATH": "${workspaceFolder}/tools" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: entrar al driver Open6009 (paquetes USB)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": { "PYTHONPATH": "${workspaceFolder}/tools" },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
